# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional plaintext chapter-content providers for chapters that the public web reader
# exposes only as previews. Comma or newline separated. Supported forms:
# - Full template: https://provider.example/chapter?book_id={book_id}&item_id={item_id}
# - Batch template: https://provider.example/batch?item_ids={item_ids}
# - batch_full-compatible URL: https://provider.example/reading/reader/batch_full/v
# Providers must return authorized, already decrypted JSON. No public provider is bundled.
FANQIE_CONTENT_API_ENDPOINTS=""

# Optional token sent as both token and Bearer authorization headers.
FANQIE_CONTENT_API_TOKEN=""

# Recommended local provider: runs the verified Tomato-Novel-Downloader v2.4.13
# release as a localhost-only sidecar and reads its chapter-id cache.
# Install once with: npm run provider:install
# Then use:
# FANQIE_CONTENT_API_ENDPOINTS="tnd-sidecar://local"
TND_PROVIDER_PORT="18429"
TND_PROVIDER_ROOT=".local/tnd-provider"
